{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NecessaryInputData",
  "type": "object",
  "properties": {
    "utxos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TxInput"
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dReps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "govActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GovernanceActionId"
      }
    },
    "lastEnactedGovAction": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GovernanceActionType"
      }
    },
    "committeeMembersCold": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LocalCredential"
      }
    },
    "committeeMembersHot": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LocalCredential"
      }
    }
  },
  "required": [
    "utxos",
    "accounts",
    "pools",
    "dReps",
    "govActions",
    "lastEnactedGovAction",
    "committeeMembersCold",
    "committeeMembersHot"
  ],
  "$defs": {
    "TxInput": {
      "type": "object",
      "properties": {
        "outputIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "txHash": {
          "type": "string"
        }
      },
      "required": [
        "outputIndex",
        "txHash"
      ]
    },
    "GovernanceActionId": {
      "type": "object",
      "properties": {
        "txHash": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0,
            "maximum": 255
          }
        },
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "txHash",
        "index"
      ]
    },
    "GovernanceActionType": {
      "type": "string",
      "enum": [
        "parameterChangeAction",
        "hardForkInitiationAction",
        "treasuryWithdrawalsAction",
        "noConfidenceAction",
        "updateCommitteeAction",
        "newConstitutionAction",
        "infoAction"
      ]
    },
    "LocalCredential": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "keyHash": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "required": [
            "keyHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scriptHash": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "required": [
            "scriptHash"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}