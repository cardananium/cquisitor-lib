{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidationInputContext",
  "type": "object",
  "properties": {
    "utxoSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UtxoInputContext"
      }
    },
    "protocolParameters": {
      "$ref": "#/$defs/ProtocolParameters"
    },
    "slot": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "accountContexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AccountInputContext"
      }
    },
    "drepContexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DrepInputContext"
      }
    },
    "poolContexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PoolInputContext"
      }
    },
    "govActionContexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GovActionInputContext"
      }
    },
    "lastEnactedGovAction": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GovActionInputContext"
      }
    },
    "currentCommitteeMembers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CommitteeInputContext"
      }
    },
    "potentialCommitteeMembers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CommitteeInputContext"
      }
    },
    "treasuryValue": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "networkType": {
      "$ref": "#/$defs/NetworkType"
    },
    "constitution": {
      "description": "Current constitution. When present, enables the ParameterChange /\n TreasuryWithdrawals guardrails-policy-hash check; when absent (older\n callers, or a provider that can't supply it) that check is skipped.",
      "anyOf": [
        {
          "$ref": "#/$defs/ConstitutionContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "utxoSet",
    "protocolParameters",
    "slot",
    "accountContexts",
    "drepContexts",
    "poolContexts",
    "govActionContexts",
    "lastEnactedGovAction",
    "currentCommitteeMembers",
    "potentialCommitteeMembers",
    "treasuryValue",
    "networkType"
  ],
  "$defs": {
    "UtxoInputContext": {
      "type": "object",
      "properties": {
        "utxo": {
          "$ref": "#/$defs/UTxO"
        },
        "isSpent": {
          "type": "boolean"
        }
      },
      "required": [
        "utxo",
        "isSpent"
      ]
    },
    "UTxO": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/TxInput"
        },
        "output": {
          "$ref": "#/$defs/TxOutput"
        }
      },
      "required": [
        "input",
        "output"
      ]
    },
    "TxInput": {
      "type": "object",
      "properties": {
        "outputIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "txHash": {
          "type": "string"
        }
      },
      "required": [
        "outputIndex",
        "txHash"
      ]
    },
    "TxOutput": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "amount": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          }
        },
        "dataHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "plutusData": {
          "type": [
            "string",
            "null"
          ]
        },
        "scriptRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "scriptHash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "address",
        "amount"
      ]
    },
    "Asset": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string"
        },
        "quantity": {
          "type": "string"
        }
      },
      "required": [
        "unit",
        "quantity"
      ]
    },
    "ProtocolParameters": {
      "type": "object",
      "properties": {
        "minFeeCoefficientA": {
          "description": "Linear factor for the minimum fee calculation formula",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "minFeeConstantB": {
          "description": "Constant factor for the minimum fee calculation formula",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "maxBlockBodySize": {
          "description": "Maximum block body size in bytes",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxTransactionSize": {
          "description": "Maximum transaction size in bytes",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxBlockHeaderSize": {
          "description": "Maximum block header size in bytes",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stakeKeyDeposit": {
          "description": "Deposit amount required for registering a stake key",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stakePoolDeposit": {
          "description": "Deposit amount required for registering a stake pool",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "maxEpochForPoolRetirement": {
          "description": "Maximum number of epochs that can be used for pool retirement ahead",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "protocolVersion": {
          "description": "Protocol version (major, minor)",
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "minPoolCost": {
          "description": "Minimum pool cost in lovelace",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "adaPerUtxoByte": {
          "description": "Cost per UTxO byte in lovelace",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "costModels": {
          "description": "Cost models for Plutus script execution",
          "$ref": "#/$defs/CostModels"
        },
        "executionPrices": {
          "description": "Price of execution units for script execution",
          "$ref": "#/$defs/ExUnitPrices"
        },
        "maxTxExecutionUnits": {
          "description": "Maximum execution units allowed for a transaction",
          "$ref": "#/$defs/ExUnits"
        },
        "maxBlockExecutionUnits": {
          "description": "Maximum execution units allowed for a block",
          "$ref": "#/$defs/ExUnits"
        },
        "maxValueSize": {
          "description": "Maximum size of a Value in bytes",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "collateralPercentage": {
          "description": "Percentage of transaction fee required as collateral",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxCollateralInputs": {
          "description": "Maximum number of collateral inputs",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "governanceActionDeposit": {
          "description": "Deposit amount required for submitting a governance action",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "drepDeposit": {
          "description": "Deposit amount required for registering as a DRep",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "referenceScriptCostPerByte": {
          "description": "Coins per byte for reference scripts",
          "$ref": "#/$defs/SubCoin"
        }
      },
      "required": [
        "minFeeCoefficientA",
        "minFeeConstantB",
        "maxBlockBodySize",
        "maxTransactionSize",
        "maxBlockHeaderSize",
        "stakeKeyDeposit",
        "stakePoolDeposit",
        "maxEpochForPoolRetirement",
        "protocolVersion",
        "minPoolCost",
        "adaPerUtxoByte",
        "costModels",
        "executionPrices",
        "maxTxExecutionUnits",
        "maxBlockExecutionUnits",
        "maxValueSize",
        "collateralPercentage",
        "maxCollateralInputs",
        "governanceActionDeposit",
        "drepDeposit",
        "referenceScriptCostPerByte"
      ]
    },
    "CostModels": {
      "type": "object",
      "properties": {
        "plutusV1": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int64"
          }
        },
        "plutusV2": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int64"
          }
        },
        "plutusV3": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "ExUnitPrices": {
      "type": "object",
      "properties": {
        "memPrice": {
          "$ref": "#/$defs/SubCoin"
        },
        "stepPrice": {
          "$ref": "#/$defs/SubCoin"
        }
      },
      "required": [
        "memPrice",
        "stepPrice"
      ]
    },
    "SubCoin": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "ExUnits": {
      "type": "object",
      "properties": {
        "mem": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "steps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "mem",
        "steps"
      ]
    },
    "AccountInputContext": {
      "type": "object",
      "properties": {
        "bech32Address": {
          "type": "string"
        },
        "isRegistered": {
          "type": "boolean"
        },
        "payedDeposit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "delegatedToDrep": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegatedToPool": {
          "type": [
            "string",
            "null"
          ]
        },
        "balance": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "bech32Address",
        "isRegistered"
      ]
    },
    "DrepInputContext": {
      "type": "object",
      "properties": {
        "bech32Drep": {
          "type": "string"
        },
        "isRegistered": {
          "type": "boolean"
        },
        "payedDeposit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "bech32Drep",
        "isRegistered"
      ]
    },
    "PoolInputContext": {
      "type": "object",
      "properties": {
        "poolId": {
          "type": "string"
        },
        "isRegistered": {
          "type": "boolean"
        },
        "retirementEpoch": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "poolId",
        "isRegistered"
      ]
    },
    "GovActionInputContext": {
      "type": "object",
      "properties": {
        "actionId": {
          "$ref": "#/$defs/GovernanceActionId"
        },
        "actionType": {
          "$ref": "#/$defs/GovernanceActionType"
        },
        "isActive": {
          "type": "boolean"
        }
      },
      "required": [
        "actionId",
        "actionType",
        "isActive"
      ]
    },
    "GovernanceActionId": {
      "type": "object",
      "properties": {
        "txHash": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0,
            "maximum": 255
          }
        },
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "txHash",
        "index"
      ]
    },
    "GovernanceActionType": {
      "type": "string",
      "enum": [
        "parameterChangeAction",
        "hardForkInitiationAction",
        "treasuryWithdrawalsAction",
        "noConfidenceAction",
        "updateCommitteeAction",
        "newConstitutionAction",
        "infoAction"
      ]
    },
    "CommitteeInputContext": {
      "type": "object",
      "properties": {
        "committeeMemberCold": {
          "$ref": "#/$defs/LocalCredential"
        },
        "committeeMemberHot": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalCredential"
            },
            {
              "type": "null"
            }
          ]
        },
        "isResigned": {
          "type": "boolean"
        }
      },
      "required": [
        "committeeMemberCold",
        "isResigned"
      ]
    },
    "LocalCredential": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "keyHash": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "required": [
            "keyHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scriptHash": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "required": [
            "scriptHash"
          ],
          "additionalProperties": false
        }
      ]
    },
    "NetworkType": {
      "type": "string",
      "enum": [
        "mainnet",
        "preview",
        "preprod"
      ]
    },
    "ConstitutionContext": {
      "description": "Current on-chain constitution, as far as the caller can supply it. Only the\n guardrails (constitution policy) script hash matters for validation.",
      "type": "object",
      "properties": {
        "guardrailScriptHash": {
          "description": "Guardrails script hash (hex). `None` means the constitution defines no\n guardrails script.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}